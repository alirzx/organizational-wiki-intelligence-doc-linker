# ============================================================================
# Organizational Wiki Intelligence - Stage 3 Document Linker
# Copy this file to .env and replace every secret / environment-specific value.
# Exactly ONE model profile must be enabled: cpu OR gpu.
# ============================================================================

# Docker Compose / image
COMPOSE_PROFILES=cpu
DOC_LINKER_IMAGE=wiki-hami-doc-linker:0.1.0
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
DOC_LINKER_REDIS_IMAGE=redis:7.4-alpine
DOC_LINKER_QDRANT_IMAGE=qdrant/qdrant:v1.19.1

# Service / auth
DOC_LINKER_API_HOST=0.0.0.0
DOC_LINKER_API_PORT=8090
DOC_LINKER_API_AUTH_TOKEN=change-me
DOC_LINKER_LOG_LEVEL=INFO

# Shared Wiki Hami MinIO. Stage 3 never accepts arbitrary MinIO endpoints per request.
DOC_LINKER_MINIO_ENDPOINT=minio:9000
DOC_LINKER_MINIO_ACCESS_KEY=change-me
DOC_LINKER_MINIO_SECRET_KEY=change-me
DOC_LINKER_MINIO_SECURE=false
DOC_LINKER_MINIO_BUCKET=media
DOC_LINKER_DOCUMENT_PREFIX=documents
DOC_LINKER_LINKING_DIR=Linking
DOC_LINKER_MINIO_AUTO_CREATE_BUCKET=false
DOC_LINKER_MAX_ARTIFACT_BYTES=104857600
DOC_LINKER_WRITE_AUDIT_ARTIFACTS=true

# Redis / Celery / durable job state
DOC_LINKER_REDIS_URL=redis://doc-linker-redis:6379/0
DOC_LINKER_CELERY_BROKER_URL=redis://doc-linker-redis:6379/0
DOC_LINKER_CELERY_RESULT_BACKEND=redis://doc-linker-redis:6379/1
DOC_LINKER_CELERY_QUEUE=wiki_hami_doc_linker
DOC_LINKER_JOB_TTL_SECONDS=604800
DOC_LINKER_LOCK_TTL_SECONDS=3600
DOC_LINKER_TASK_MAX_RETRIES=3
DOC_LINKER_TASK_RETRY_BACKOFF_SECONDS=3

# Qdrant
DOC_LINKER_QDRANT_URL=http://doc-linker-qdrant:6333
DOC_LINKER_QDRANT_API_KEY=
DOC_LINKER_QDRANT_COLLECTION=wiki_chunks_v1
DOC_LINKER_QDRANT_DENSE_VECTOR_NAME=dense
DOC_LINKER_QDRANT_SPARSE_VECTOR_NAME=sparse
DOC_LINKER_QDRANT_VECTOR_SIZE=1024
DOC_LINKER_QDRANT_TIMEOUT_SECONDS=30
DOC_LINKER_QDRANT_UPSERT_BATCH_SIZE=64

# Model service. Both CPU/GPU Compose variants publish the same internal alias: model-service.
DOC_LINKER_MODEL_SERVICE_URL=http://model-service:8091
DOC_LINKER_MODEL_SERVICE_TOKEN=change-model-service-token
DOC_LINKER_MODEL_SERVICE_TIMEOUT_SECONDS=180
DOC_LINKER_MODEL_SERVICE_WARMUP=true

# BGE-M3 embedding
DOC_LINKER_EMBEDDING_BACKEND=http
DOC_LINKER_EMBEDDING_MODEL=BAAI/bge-m3
DOC_LINKER_EMBEDDING_DEVICE=cpu
DOC_LINKER_EMBEDDING_USE_FP16=false
DOC_LINKER_EMBEDDING_BATCH_SIZE=8
DOC_LINKER_EMBEDDING_MAX_LENGTH=1024
DOC_LINKER_ENABLE_SPARSE=true

# BGE reranker
DOC_LINKER_RERANKER_BACKEND=http
DOC_LINKER_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
DOC_LINKER_RERANKER_DEVICE=cpu
DOC_LINKER_RERANKER_USE_FP16=false
DOC_LINKER_RERANKER_MAX_LENGTH=1024

# For GPU deployment set:
# COMPOSE_PROFILES=gpu
# TORCH_INDEX_URL=<approved PyTorch CUDA wheel index for the server>
# DOC_LINKER_EMBEDDING_DEVICE=cuda:0
# DOC_LINKER_EMBEDDING_USE_FP16=true
# DOC_LINKER_RERANKER_DEVICE=cuda:0
# DOC_LINKER_RERANKER_USE_FP16=true

# Chunking. Stage-2 section boundaries are always preserved.
DOC_LINKER_CHUNK_TARGET_TOKENS=600
DOC_LINKER_CHUNK_MAX_TOKENS=900
DOC_LINKER_CHUNK_MIN_TOKENS=120
DOC_LINKER_CHUNK_OVERLAP_TOKENS=80
DOC_LINKER_SEMANTIC_BREAK_PERCENTILE=25.0

# Retrieval
DOC_LINKER_RETRIEVAL_MODE=hybrid
DOC_LINKER_RETRIEVAL_CANDIDATE_LIMIT=40
DOC_LINKER_SEARCH_DEFAULT_LIMIT=5
DOC_LINKER_SEARCH_MAX_LIMIT=20
DOC_LINKER_RRF_K=60

# Backend callback. Destination is configured here, never supplied by a request.
DOC_LINKER_CALLBACK_URL=
DOC_LINKER_CALLBACK_TOKEN=
DOC_LINKER_CALLBACK_TIMEOUT_SECONDS=15
DOC_LINKER_CALLBACK_MAX_ATTEMPTS=3

# Pipeline identity / audit reproducibility
DOC_LINKER_PIPELINE_VERSION=1.0.0
DOC_LINKER_CHUNKER_VERSION=1.0.0
